SELECT DISTINCT
       D.LOCATION,
       D.COLLID,
       D.NAME       AS PACKAGE,
       D.VERSION,
       S.STMTNO,
       S.TEXT
FROM SYSIBM.SYSPACKDEP D
JOIN SYSIBM.SYSPACKSTMT S
  ON D.LOCATION = S.LOCATION
 AND D.COLLID   = S.COLLID
 AND D.NAME     = S.NAME
 AND D.VERSION  = S.VERSION
WHERE D.BQUALIFIER = 'YOUR_SCHEMA'
  AND D.BNAME      = 'EPRJ'
  AND D.BTYPE      = 'T'
  AND UPPER(S.TEXT) LIKE '%STD_HRS_Q%'
ORDER BY
      D.COLLID,
      D.NAME,
      S.STMTNO;