SELECT DISTINCT
       P.COLLID,
       P.NAME AS PACKAGE,
       S.STMTNO,
       S.TEXT
FROM SYSIBM.SYSPACKAGE P
JOIN SYSIBM.SYSPACKSTMT S
  ON P.COLLID = S.COLLID
 AND P.NAME   = S.NAME
WHERE S.TEXT LIKE '%HOURS%'
  AND P.NAME IN (
      SELECT BNAME
      FROM SYSIBM.SYSPACKDEP
      WHERE DTYPE='T'
        AND DNAME='PAY_DETAIL'
  );