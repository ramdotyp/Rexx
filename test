WITH SQL_STMTS AS
(
    SELECT
        COLLID,
        NAME,
        STMTNO,
        UPPER(
          CAST(STATEMENT AS VARCHAR(32000))
        ) AS SQLTEXT
    FROM SYSIBM.SYSPACKSTMT
    WHERE COLLID = 'LOS2'
)
SELECT
    COLLID,
    NAME AS PROGRAM_NAME,
    STMTNO,
    CASE
        WHEN SQLTEXT LIKE '%UPDATE %'
         AND SQLTEXT LIKE '%SET %'
            THEN 'UPDATE - REVIEW SET'

        WHEN SQLTEXT LIKE '%INSERT INTO%'
            THEN 'INSERT - REVIEW COLUMNS'

        WHEN SQLTEXT LIKE '%SELECT %'
          OR SQLTEXT LIKE '%DECLARE %'
            THEN 'READ - REVIEW SELECT'

        WHEN SQLTEXT LIKE '%DELETE FROM%'
            THEN 'DELETE - REVIEW WHERE'

        ELSE 'OTHER'
    END AS OPERATION_TYPE,
    SQLTEXT
FROM SQL_STMTS
WHERE SQLTEXT LIKE '%HRS_1_Q%'
  AND SQLTEXT LIKE '%RNT%'
ORDER BY
    PROGRAM_NAME,
    STMTNO;