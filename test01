SELECT DISTINCT
       P.COLLID,
       P.NAME       AS PROGRAM,
       P.VERSION,
       P.VALID,
       P.OPERATIVE,
       P.BINDTIME
FROM SYSIBM.SYSPACKAGE P
WHERE EXISTS
 (SELECT 1
    FROM SYSIBM.SYSPACKDEP D
   WHERE D.DCOLLID = P.COLLID
     AND D.DNAME   = P.NAME
     AND D.DCONTOKEN = P.CONTOKEN
     AND D.BQUALIFIER = 'YOUR_SCHEMA'
     AND D.BNAME      = 'YOUR_TABLE'
     AND D.BTYPE      = 'T')
ORDER BY P.COLLID, P.NAME, P.VERSION
WITH UR;


SELECT DCREATOR AS VIEW_SCHEMA,
       DNAME    AS VIEW_NAME
FROM SYSIBM.SYSVIEWDEP
WHERE BCREATOR = 'YOUR_SCHEMA'
  AND BNAME    = 'YOUR_TABLE'
  AND BTYPE    = 'T'
WITH UR;





