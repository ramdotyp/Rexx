SELECT DISTINCT
       P.PROGNAME,
       P.COLLID,
       P.NAME      AS PACKAGE,
       P.VERSION,
       S.STMTNO,
       S.SEQNO
FROM SYSIBM.SYSPACKSTMT S
JOIN SYSIBM.SYSPACKAGE P
  ON S.LOCATION = P.LOCATION
 AND S.COLLID   = P.COLLID
 AND S.NAME     = P.NAME
 AND S.VERSION  = P.VERSION
WHERE UPPER(S.STATEMENT) LIKE '%STD_HRS_Q%'
  AND UPPER(S.STATEMENT) LIKE '%EPRJ%'
ORDER BY P.PROGNAME, P.COLLID, P.NAME, S.STMTNO;